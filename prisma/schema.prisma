// Prisma schema for Czech Family Budget Application

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Expense categories (flat list, 10-20 items)
model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  icon     String?
  order    Int       @default(0)
  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Monthly expense totals by category
model Expense {
  id         String   @id @default(cuid())
  amount     Float
  year       Int
  month      Int      // 1-12
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, year, month])
  @@index([year, month])
}

// Income sources
model IncomeSource {
  id      String   @id @default(cuid())
  name    String   @unique
  order   Int      @default(0)
  incomes Income[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Monthly income by source
model Income {
  id       String       @id @default(cuid())
  amount   Float
  year     Int
  month    Int          // 1-12
  source   IncomeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, year, month])
  @@index([year, month])
}

// Investment types (e.g., Zlato, Penzijni)
model InvestmentType {
  id              String       @id @default(cuid())
  name            String       @unique
  order           Int          @default(0)
  totalInvested   Float?       // Total amount already invested (principal)
  annualRate      Float?       // Expected annual return rate (e.g., 0.07 for 7%)
  investmentYears Int?         // Investment horizon in years
  investments     Investment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Monthly investment amounts by type
model Investment {
  id     String         @id @default(cuid())
  amount Float
  year   Int
  month  Int            // 1-12
  type   InvestmentType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  typeId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([typeId, year, month])
  @@index([year, month])
}

// Saving goals / Funds
model SavingGoal {
  id            String             @id @default(cuid())
  name          String
  targetAmount  Float?
  currentAmount Float              @default(0)
  isEmergency   Boolean            @default(false) // Emergency fund flag
  order         Int                @default(0)
  transactions  FundTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Fund transactions (deposits/withdrawals)
model FundTransaction {
  id           String     @id @default(cuid())
  amount       Float      // positive = deposit, negative = withdrawal
  description  String?
  date         DateTime   @default(now())
  savingGoal   SavingGoal @relation(fields: [savingGoalId], references: [id], onDelete: Cascade)
  savingGoalId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([savingGoalId])
  @@index([date])
}

// Saved loan scenarios for comparison
model LoanScenario {
  id              String  @id @default(cuid())
  name            String
  amount          Float
  interestRate    Float
  termMonths      Int
  type            String  // "MORTGAGE" | "CONSUMER"
  monthlyPayment  Float
  totalPayment    Float
  totalInterest   Float

  // Verdict/evaluation data
  verdictStatus   String?  // "AVAILABLE" | "RISKY" | "NOT_RECOMMENDED"
  verdictLabel    String?  // Czech label
  verdictReason   String?  // Explanation text
  budgetImpact    Float?   // Percentage of monthly income

  // Budget context at time of analysis
  budgetIncome    Float?
  budgetExpenses  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Active loans (existing loans being paid off)
model ActiveLoan {
  id              String   @id @default(cuid())
  name            String
  type            String   // "MORTGAGE" | "CONSUMER"
  originalAmount  Float    // Original loan amount
  remainingAmount Float    // Current balance (updated manually or calculated)
  interestRate    Float    // Annual interest rate (%)
  monthlyPayment  Float    // Monthly payment amount
  startDate       DateTime // When the loan started
  termMonths      Int      // Original term in months

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Household settings for benchmark comparisons
model HouseholdSettings {
  id                   String  @id @default("default")
  totalMembers         Int     @default(1)  // Total people in household
  dependentChildren    Int     @default(0)  // Number of dependent children
  adults               Int     @default(1)  // Number of adults
  emergencyFundTarget  Int?    // User-defined emergency fund target in Kč (null = use calculation based on months)
  emergencyFundMonths  Int     @default(3)  // Number of months of expenses for emergency fund
  sidebarExpanded      Boolean @default(false)  // Whether sidebar is expanded or collapsed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// AI insights cache for performance
model AIInsightsCache {
  id               String   @id @default("default")
  overviewInsight  String   // Main overview (narrative + bullets)
  categoryInsights String   // JSON: { categoryId: insight }
  generatedAt      DateTime
  dataHash         String   // Hash of source data for invalidation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// AI feedback collection
model AIFeedback {
  id          String   @id @default(cuid())
  insightType String   // "overview" | "category" | "suggestion"
  insightId   String?  // Optional: category ID or suggestion identifier
  isPositive  Boolean  // true = thumbs up, false = thumbs down

  createdAt DateTime @default(now())
}

// Bank statement uploads for AI parsing
model BankStatementUpload {
  id               String   @id @default(cuid())
  filename         String   // Original filename
  statementPeriod  String   // e.g., "12/2025" extracted from statement
  accountNumber    String?  // Bank account number from statement
  bankName         String?  // Bank name (e.g., "Česká spořitelna")
  startingBalance  Float?   // Opening balance
  endingBalance    Float?   // Closing balance
  totalCredits     Float?   // Total income/credits
  totalDebits      Float?   // Total expenses/debits
  transactionCount Int?     // Number of transactions parsed
  status           String   @default("pending") // "pending" | "reviewed" | "applied"
  appliedAt        DateTime? // When transactions were applied to expenses

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

